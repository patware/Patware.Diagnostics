<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>Patware.ApplicationEvents.Hosting</PackageId>
    <AssemblyName>Patware.ApplicationEvents.Hosting</AssemblyName>
    <RootNamespace>Patware.ApplicationEvents.Hosting</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Description>
      Automatic application lifecycle events for the .NET Generic Host.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApplicationEvents.Core/ApplicationEvents.Core.csproj" />
  </ItemGroup>

</Project>