<Window x:Class="SampleWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application events"
        Height="340"
        Width="650">

  <StackPanel Margin="24"
                VerticalAlignment="Center">

    <TextBlock Text="Application events"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

    <TextBlock Text="Watch Visual Studio's Debug output for Patware events."
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

    <TextBlock Text="Simulating a fatal exception terminates this application."
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

    <StackPanel Orientation="Horizontal">
      <Button x:Name="ExceptionButton"
                    Content="Simulate fatal exception (701)"
                    Padding="12,8"
                    Margin="0,0,12,0"
                    Click="Exception_Button_Click" />

      <Button x:Name="ExitButton"
                    Content="Shut down gracefully"
                    Padding="12,8"
                    Click="Exit_Button_Click" />
    </StackPanel>

    <TextBlock x:Name="StatusText"
                   Text="Application is running."
                   TextWrapping="Wrap"
                   Margin="0,16,0,0" />
  </StackPanel>
</Window>
