<Window x:Class="SampleWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application events"
        Height="540"
        Width="720"
        MinHeight="450"
        MinWidth="580">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Application events"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,12" />

      <TextBlock Text="Watch Visual Studio's Debug output for Patware events."
                       TextWrapping="Wrap"
                       Margin="0,0,0,20" />

      <TextBlock Text="Coffee price"
                       FontSize="20"
                       FontWeight="SemiBold" />

      <TextBlock Text="Refresh the price from our simulated product service. If it times out, the last successful value remains available."
                       TextWrapping="Wrap"
                       Margin="0,8,0,12" />

      <WrapPanel>
        <Button x:Name="RefreshButton"
                        Content="Refresh price"
                        Padding="12,8"
                        Margin="0,0,12,8"
                        Click="Refresh_Button_Click" />

        <Button x:Name="AvailabilityButton"
                        Content="Simulate timeout"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Click="Availability_Button_Click" />
      </WrapPanel>

      <TextBlock x:Name="AvailabilityText"
                       Text="Refresh the price from our simulated product service. If the refresh fails, the last successful value remains available."
                       Margin="0,4,0,12" />

      <Border x:Name="WarningPanel"
                    Visibility="Collapsed"
                    Background="#FFF4CE"
                    BorderBrush="#8A6500"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12">
        <TextBlock x:Name="WarningText"
                           Foreground="#453300"
                           TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
      </Border>

      <TextBlock x:Name="PriceText"
                       Text="No price loaded yet."
                       FontSize="22"
                       FontWeight="SemiBold" />

      <TextBlock x:Name="UpdatedText"
                       Text="Press Refresh to get started."
                       TextWrapping="Wrap"
                       Margin="0,4,0,8" />

      <TextBlock x:Name="CatalogStatusText"
                       Text="Ready to refresh."
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />

      <Separator Margin="0,20" />

      <TextBlock Text="Simulating a fatal exception terminates this application."
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

      <WrapPanel>
        <Button x:Name="ExceptionButton"
                        Content="Simulate fatal exception (701)"
                        Padding="12,8"
                        Margin="0,0,12,8"
                        Click="Exception_Button_Click" />

        <Button x:Name="ExitButton"
                        Content="Shut down gracefully"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Click="Exit_Button_Click" />
      </WrapPanel>

      <TextBlock x:Name="StatusText"
                       Text="Application is running."
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>